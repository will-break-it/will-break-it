---
// A service page or a case study, rendered from one Markdown file.
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import { type Entry, find, list } from '../lib/content';
import { type Lang, T, ORIGIN, PERSON_ID, RATE, abs, home } from '../lib/site';
import { entryCard } from '../lib/previews';

interface Props { entry: Entry }
const { entry } = Astro.props;
const lang: Lang = entry.lang;
const t = T[lang];
const isWork = entry.kind === 'work';
const paths = { en: find(entry.kind, entry.key, 'en').path, de: find(entry.kind, entry.key, 'de').path };

const card = entryCard(entry);
const relatedKind = isWork ? 'services' : 'work';
const related = entry.related.map(key => find(relatedKind, key, lang));
const siblings = list(entry.kind, lang).filter(e => e.key !== entry.key);
const briefHref = `${home(lang)}?type=${entry.brief}#brief`;
const facts = Object.entries(entry.facts) as [keyof typeof t.facts, string][];

const page = abs(entry.path);
const breadcrumb = {
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Willi Wolff', item: abs(home(lang)) },
        { '@type': 'ListItem', position: 2, name: entry.title, item: page },
    ],
};
const main = isWork
    ? {
        '@type': 'Article',
        '@id': `${page}#article`,
        headline: entry.title,
        description: entry.description,
        inLanguage: lang,
        dateModified: entry.updated,
        datePublished: entry.updated,
        author: { '@id': PERSON_ID },
        publisher: { '@id': PERSON_ID },
        mainEntityOfPage: page,
        image: abs(card.image),
    }
    : {
        '@type': 'Service',
        '@id': `${page}#service`,
        name: entry.title,
        description: entry.description,
        url: page,
        inLanguage: lang,
        provider: { '@id': PERSON_ID },
        areaServed: { '@type': 'Place', name: 'Worldwide' },
        availableLanguage: ['de', 'en'],
        offers: {
            '@type': 'Offer',
            priceSpecification: {
                '@type': 'UnitPriceSpecification',
                minPrice: RATE.from,
                maxPrice: RATE.to,
                priceCurrency: RATE.currency,
                unitCode: 'HUR',
                unitText: 'hour',
            },
        },
    };
const jsonld = {
    '@context': 'https://schema.org',
    '@graph': [
        { '@type': 'Person', '@id': PERSON_ID, name: 'Willi Wolff', url: `${ORIGIN}/` },
        main,
        breadcrumb,
    ],
};
// Search results cut a title at about 65 characters, so a long one drops the name.
const withName = `${entry.title} – Willi Wolff`;
const pageTitle = withName.length <= 65 ? withName : entry.title;
const updated = new Date(entry.updated + 'T00:00:00Z').toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base lang={lang} title={pageTitle} description={entry.description} path={entry.path} paths={paths} jsonld={jsonld} ogType={isWork ? 'article' : 'website'} card={card} updated={entry.updated} markdownPath={entry.markdownPath}>
    <main class="page" id="top">
        <div class="content">
            <article class="article">
                <nav class="article-crumb" aria-label={lang === 'de' ? 'Pfad' : 'Breadcrumb'}>
                    <a href={`${home(lang)}#work`}>{t.back}</a>
                    <span>{isWork ? t.workKicker : t.serviceKicker}</span>
                </nav>
                <header class="article-head">
                    <h1>{entry.title}</h1>
                    <p class="article-lead">{entry.lead}</p>
                    <div class="article-actions">
                        <a class="btn btn-primary btn-lg" href={briefHref}>{t.sendBrief}</a>
                        <a class="text-link" href={entry.markdownPath}>{t.markdown}</a>
                    </div>
                </header>

                <div class="article-grid">
                    <div class="article-body prose" set:html={entry.html} />
                    <aside class="article-side">
                        {facts.length > 0 && (
                            <dl class="facts">
                                {facts.map(([name, value]) => (
                                    <div><dt>{t.facts[name] ?? name}</dt><dd>{value}</dd></div>
                                ))}
                            </dl>
                        )}
                        {entry.proof.length > 0 && (
                            <div class="side-list">
                                <h2 class="list-head">{t.proof}</h2>
                                <ul>{entry.proof.map(link => <li><a href={link.href} target="_blank" rel="noopener">{link.label}</a></li>)}</ul>
                            </div>
                        )}
                        {related.length > 0 && (
                            <div class="side-list">
                                <h2 class="list-head">{isWork ? t.relatedService : t.related}</h2>
                                <ul>{related.map(item => <li><a href={item.path}>{item.title}</a></li>)}</ul>
                            </div>
                        )}
                    </aside>
                </div>

                <section class="article-cta" aria-labelledby="cta-title">
                    <h2 id="cta-title">{t.similar}</h2>
                    <p>{t.similarText}</p>
                    <div class="article-actions">
                        <a class="btn btn-primary btn-lg" href={briefHref}>{t.sendBrief}</a>
                        <a class="btn btn-lg" href={`/willi-wolff-cv-${lang}.pdf`} download>CV (PDF)</a>
                    </div>
                </section>

                <div class="side-list" style="margin-top: var(--s-7)">
                    <h2 class="list-head">{isWork ? (lang === 'de' ? 'Weitere Fallstudien' : 'More case studies') : t.moreServices}</h2>
                    <ul>{siblings.map(item => <li><a href={item.path}>{item.title}</a></li>)}</ul>
                </div>
                <p class="article-meta">{t.updated}: <time datetime={entry.updated}>{updated}</time></p>
            </article>
            <Footer lang={lang} markdownPath={entry.markdownPath} />
        </div>
    </main>
</Base>
