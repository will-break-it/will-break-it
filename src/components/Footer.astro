---
import { type Lang, T, EMAIL } from '../lib/site';
interface Props { lang: Lang; markdownPath?: string }
const { lang, markdownPath } = Astro.props;
const t = T[lang];
---
<footer class="site-foot">
    <p>Willi Wolff · Berlin · <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    <p class="agents-row">
        <strong>{t.forAgents}</strong>{' · '}
        {markdownPath && <><a href={markdownPath}>{t.markdown}</a>{' · '}</>}
        <a href="/llms.txt">llms.txt</a> · <a href="/hire.json">hire.json</a> · <a href="/cv.md">cv.md</a> · <a href="/cv.json">cv.json</a> · <a href="/openapi.json">openapi.json</a> · <a href="/api/enquiry">POST /api/enquiry</a> · <a href="/mcp">MCP /mcp</a>
    </p>
</footer>
